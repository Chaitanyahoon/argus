# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_token_here

# Comma-separated Discord user IDs allowed to issue voice commands
ADMIN_USER_IDS=123456789,987654321

# Google Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_key_here

# Text command prefix
COMMAND_PREFIX=!

# TempVoice: optional IDs for Create VC channel and category for temp channels
# TEMP_VOICE_TRIGGER_CHANNEL_ID=123456789
# TEMP_VOICE_CATEGORY_ID=987654321
# TempVoice: optional text channel where the VC management interface is sent (users manage their VC from here)
# TEMP_VOICE_INTERFACE_CHANNEL_ID=123456789

# TempVoice: optional instruction image (replaces text legend in interface). Use a local path or a Google Drive URL.
# TEMP_VOICE_INSTRUCTION_IMAGE_PATH=https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=drive_link
# Or: TEMP_VOICE_INSTRUCTION_IMAGE_PATH=assets/tempvoice_instruction.png
