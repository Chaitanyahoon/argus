# ============================================================================
# REQUIRED VARIABLES - Bot will not start without these
# ============================================================================

# Discord Bot Token
# Get from: https://discord.com/developers/applications
# 1. Create New Application → Bot tab → Add Bot
# 2. Under TOKEN section, click Copy
DISCORD_TOKEN=your_token_here

# Comma-separated Discord user IDs allowed to issue voice commands
# To find your User ID: Enable Developer Mode in Discord → right-click name → Copy User ID
ADMIN_USER_IDS=123456789,987654321

# Google Gemini API key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ============================================================================
# OPTIONAL VARIABLES - Defaults provided if not set
# ============================================================================

# Text command prefix (default: !)
COMMAND_PREFIX=!

# Gemini voice output model (default: Aoede)
# Options: Aoede, Zyra, Charon, Fenrir, Orion
GEMINI_VOICE=Aoede

# Whisper model size for speech-to-text (default: base.en)
# Options: tiny.en, base.en, small.en, medium.en
# Smaller = faster, Larger = more accurate
WHISPER_MODEL=base.en

# Log level for debugging (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# TEMPORARY VOICE CHANNEL FEATURES (Optional)
# ============================================================================

# Discord Channel ID where users can trigger temporary voice channel creation
TEMP_VOICE_TRIGGER_CHANNEL_ID=123456789

# Discord Category ID where temporary voice channels will be created
TEMP_VOICE_CATEGORY_ID=987654321

# Text channel where voice channel management interface is posted
TEMP_VOICE_INTERFACE_CHANNEL_ID=123456789

# Custom welcome message for temporary voice channels
TEMP_VOICE_WELCOME_MESSAGE=Welcome To Your Pvt Space, If anyone force enters vc report the, to management!

# Optional instruction image (replaces text legend in interface)
# Use local path or Google Drive URL:
# TEMP_VOICE_INSTRUCTION_IMAGE_PATH=https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=drive_link
# Or: TEMP_VOICE_INSTRUCTION_IMAGE_PATH=assets/tempvoice_instruction.png
TEMP_VOICE_INSTRUCTION_IMAGE_PATH=
